{
  "Logging": {
    "LogLevel": {
      "Default": "Error"
    }
  },
  "EmailSettings": {
    "SenderType": "smtp",
    "RetryCountLimit": 5
  },
  "Smtp": {
    "Host": "smtp_server",
    "Issuer": "issuer",
    "IssuerEmail": "issuer@domain.com",
    "Port": 999,
    "Account": "account",
    "Password": "password",
    "SSL": false
  },
  "Auth": {
    "issuerSigningKey": "_________________issuerSigningKey_________________",
    "issuer": "WebAGK",
    "validIssuer": "WebAGK",
    "validateAudience": false,
    "validateIssuer": true,
    "validateLifetime": true,
    "expiry": "00:10:00",
    "refreshexpiry": "00:30:00",
    "emailConfirmType": "code"
  },
  "Postgres": {
    "connectionString": "Host=host;Port=port;Database=WebAGK;Username=username;Password=password"
  },
  "StoredFilePath": {
    "path": ".\\storedFiles"
  },
    "AllowedHost": "localhost"
  }
